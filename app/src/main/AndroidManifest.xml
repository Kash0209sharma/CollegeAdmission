<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/ic_graduation_cap"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_graduation_cap"
        android:supportsRtl="true"
        android:theme="@style/Theme.CollegeAdmissionApp">
        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.CollegeAdmissionApp.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>


        <activity
            android:name=".ui.LoginActivity"
            android:exported="false"
            android:theme="@style/Theme.CollegeAdmissionApp.NoActionBar" />

        <activity
            android:name=".ui.RegisterActivity"
            android:exported="false"
            android:theme="@style/Theme.CollegeAdmissionApp.NoActionBar" />

        <activity
            android:name=".ui.DashboardActivity"
            android:exported="false"
            android:theme="@style/Theme.CollegeAdmissionApp.NoActionBar" />

        <activity
            android:name=".ui.NewsActivity"
            android:exported="true"
            android:theme="@style/Theme.CollegeAdmissionApp.NoActionBar" >
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.ChatbotActivity"
            android:exported="true"
            android:theme="@style/Theme.CollegeAdmissionApp.NoActionBar"
            android:parentActivityName=".ui.DashboardActivity">

            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>

        </activity>


        <activity
            android:name=".ui.ProfileActivity"
            android:exported="false"
            android:theme="@style/Theme.CollegeAdmissionApp.NoActionBar" />
        <!-- NEW ACTIVITIES -->
        <activity
            android:name=".ui.CoursesActivity"
            android:exported="false"
            android:theme="@style/Theme.CollegeAdmissionApp.NoActionBar"
            android:parentActivityName=".ui.DashboardActivity" />

        <activity
            android:name=".ui.UniversitiesActivity"
            android:exported="false"
            android:theme="@style/Theme.CollegeAdmissionApp.NoActionBar"
            android:parentActivityName=".ui.DashboardActivity" />

        <activity
            android:name=".ui.CollegesActivity"
            android:exported="false"
            android:theme="@style/Theme.CollegeAdmissionApp.NoActionBar"
            android:parentActivityName=".ui.DashboardActivity" />

        <activity
            android:name=".ui.ShortcutRouterActivity"
            android:exported="true"
            android:theme="@style/Theme.CollegeAdmissionApp.NoActionBar" />

    </application>

</manifest>